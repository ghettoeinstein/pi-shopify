<div style="max-width:800px;margin:0 auto;padding:40px 24px;">
  <h1>{{ blog.title }}</h1>
  {% for article in blog.articles %}
    <a href="{{ article.url }}" style="display:block;color:inherit;text-decoration:none;padding:12px 0;border-bottom:1px solid rgba(255,255,255,0.1);">{{ article.title }}</a>
  {% endfor %}
</div>
