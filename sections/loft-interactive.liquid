{% liquid
  assign loft_collection = collections[section.settings.collection]
  if loft_collection == blank
    assign loft_collection = collections.all
  endif
%}
<section id="PILoft-{{ section.id }}" class="pi-loft" data-pi-loft>
  <canvas class="pi-loft__shader" data-pi-shader aria-hidden="true"></canvas>
  <div class="pi-loft__chrome" aria-hidden="true"><span>PRIVATE SHOWROOM / 01</span><span>DRAG TO MOVE</span></div>
  <header class="pi-loft__identity"><p>{{ section.settings.eyebrow }}</p><h1>THE<br><em>LOFT</em></h1></header>
  <div class="pi-loft__rack" data-pi-rack aria-label="Interactive product rack">
    {% assign shown = 0 %}
    {% for product in loft_collection.products %}
      {% unless product.handle contains 'asset-pack' %}
        {% assign shown = shown | plus: 1 %}
        <a class="pi-garment" href="{{ product.url }}" data-pi-garment data-title="{{ product.title | escape }}" data-price="{{ product.price | money | escape }}">
          <span class="pi-garment__hanger" aria-hidden="true"></span>
          {% if product.featured_image %}
            {{ product.featured_image | image_url: width: 1000 | image_tag: class: 'pi-garment__image', loading: 'eager', widths: '360, 540, 720, 1000', alt: product.title }}
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'pi-garment__image' }}
          {% endif %}
          <span class="pi-garment__caption"><b>0{{ shown }}</b><strong>{{ product.title }}</strong><small>{{ product.price | money }}</small></span>
        </a>
        {% if shown == section.settings.product_limit %}{% break %}{% endif %}
      {% endunless %}
    {% endfor %}
  </div>
  <aside class="pi-loft__focus" data-pi-focus aria-live="polite">
    <span data-pi-count>01 / 04</span><h2 data-pi-title>SELECT A GARMENT</h2><p data-pi-price></p><b>HOLD TO ENTER</b><i data-pi-progress></i>
  </aside>
  <div class="pi-loft__instructions"><span class="pi-loft__desktop-help">DRAG THE ROOM · TAP TO FOCUS · HOLD TO ENTER</span><span class="pi-loft__mobile-help">SWIPE THE RACK · TAP TO FOCUS · TAP AGAIN TO ENTER</span></div>
  <a class="pi-loft__grid-link" href="{{ loft_collection.url | default: routes.all_products_collection_url }}">VIEW AS GRID ↗</a>
  <noscript><p class="pi-loft__noscript"><a href="{{ loft_collection.url }}">Shop the collection.</a></p></noscript>
</section>
{{ 'loft-scene.css' | asset_url | stylesheet_tag }}
<script src="{{ 'loft-scene.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "PI New York Loft",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "MADE IN SOUTH CENTRAL / LOS ANGELES" },
    { "type": "range", "id": "product_limit", "label": "Garments on rack", "min": 2, "max": 6, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "PI New York Loft" }]
}
{% endschema %}
