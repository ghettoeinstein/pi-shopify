<section
  class="loft"
  id="Loft-{{ section.id }}"
  data-loft
  data-section-id="{{ section.id }}"
>
  <div class="loft__intro">
    {% if section.settings.eyebrow != blank %}
      <p class="loft__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="loft__heading">{{ section.settings.heading }}</h2>
    {% endif %}
  </div>

  {% comment %} 3D mount point — JS replaces/hides the fallback grid below when WebGL + viewport allow it. {% endcomment %}
  <div class="loft__stage" data-loft-stage aria-hidden="true">
    <canvas data-loft-canvas></canvas>
    <div class="loft__panel" data-loft-panel hidden>
      <button type="button" class="loft__panel-close" data-loft-panel-close aria-label="Close">&times;</button>
      <div class="loft__panel-body" data-loft-panel-body></div>
    </div>
    <p class="loft__hint">Drag to look around &middot; click a piece to shop it</p>
  </div>

  {% comment %} Accessible fallback — always rendered, real Liquid product data, works with JS off. {% endcomment %}
  <div class="loft__fallback" data-loft-fallback>
    <div class="loft__fallback-grid">
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        {% if product != blank %}
          <a class="loft__fallback-card" href="{{ product.url }}" {{ block.shopify_attributes }}>
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 480 }}"
                alt="{{ product.featured_image.alt | escape }}"
                loading="lazy"
                width="480"
                height="{{ 480 | divided_by: product.featured_image.aspect_ratio }}"
              >
            {% endif %}
            <span class="loft__fallback-title">{{ block.settings.label | default: product.title }}</span>
            <span class="loft__fallback-price">{{ product.price | money }}</span>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  {% comment %} Hotspot data for loft-scene.js — public product fields only. {% endcomment %}
  {{ 'loft-scene.css' | asset_url | stylesheet_tag }}
  <script type="application/json" data-loft-hotspots>
    [
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        {% if product != blank %}
          {
            "id": {{ block.id | json }},
            "spot": {{ block.settings.spot | json }},
            "label": {{ block.settings.label | default: product.title | json }},
            "title": {{ product.title | json }},
            "price": {{ product.price | money | json }},
            "image": {{ product.featured_image | image_url: width: 800 | json }},
            "url": {{ product.url | json }},
            "variantId": {{ product.selected_or_first_available_variant.id | json }},
            "available": {{ product.available | json }}
          }{% unless forloop.last %},{% endunless %}
        {% endif %}
      {% endfor %}
    ]
  </script>

  <script type="module" src="{{ 'loft-scene.js' | asset_url }}" defer></script>
</section>

{% schema %}
{
  "name": "Loft Interactive",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "INTERACTIVE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Step into the loft." },
    {
      "type": "select",
      "id": "quality",
      "label": "Rendering quality",
      "options": [
        { "value": "auto", "label": "Auto (recommended)" },
        { "value": "high", "label": "Always high" },
        { "value": "low", "label": "Always low-power" }
      ],
      "default": "auto"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        {
          "type": "select",
          "id": "spot",
          "label": "Placement in the room",
          "options": [
            { "value": "sofa", "label": "Sofa" },
            { "value": "shelf", "label": "Shelf" },
            { "value": "table", "label": "Table" },
            { "value": "rack", "label": "Clothing rack" },
            { "value": "plant", "label": "Plant corner" }
          ],
          "default": "sofa"
        },
        { "type": "text", "id": "label", "label": "Label override (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Loft Interactive",
      "blocks": [
        { "type": "hotspot", "settings": { "spot": "sofa" } },
        { "type": "hotspot", "settings": { "spot": "shelf" } },
        { "type": "hotspot", "settings": { "spot": "rack" } }
      ]
    }
  ]
}
{% endschema %}
